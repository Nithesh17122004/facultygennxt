# FacultyNxtGen environment template.
# Copy to .env and replace every placeholder. Never commit real secrets.
# Development uses config.settings.development; production uses config.settings.production.

DJANGO_SETTINGS_MODULE=config.settings.development
DJANGO_DEBUG=True
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=replace-with-a-long-random-value
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,127.0.0.1:8000
CSRF_TRUSTED_ORIGINS=
SITE_URL=http://127.0.0.1:8000

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Production requires PostgreSQL. Development falls back to db.sqlite3 when
# neither DATABASE_URL nor POSTGRES_DB is set.
# DATABASE_URL=postgresql://facultynxtgen:password@127.0.0.1:5432/facultynxtgen?sslmode=prefer
# POSTGRES_DB=facultynxtgen
# POSTGRES_USER=facultynxtgen
# POSTGRES_PASSWORD=replace-me
# POSTGRES_HOST=127.0.0.1
# POSTGRES_PORT=5432
# POSTGRES_SSLMODE=prefer
DB_CONN_MAX_AGE=60
# PRIVATE_MEDIA_ROOT=C:\absolute\path\to\private-media

# ---------------------------------------------------------------------------
# Cache and background jobs
# ---------------------------------------------------------------------------
# REDIS_URL=redis://127.0.0.1:6379/0
# CELERY_BROKER_URL=redis://127.0.0.1:6379/0
# CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/1
CELERY_TASK_ALWAYS_EAGER=True

# ---------------------------------------------------------------------------
# Email (Resend API preferred; SMTP/Django fallback for development)
# ---------------------------------------------------------------------------
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=FacultyNxtGen <noreply@example.com>
SUPPORT_EMAIL=support@example.com
# RESEND_API_KEY=
# RESEND_FROM_EMAIL=FacultyNxtGen <notifications@example.com>
# RESEND_WEBHOOK_SECRET=
EMAIL_VERIFICATION_MAX_AGE=172800

# ---------------------------------------------------------------------------
# Security
# ---------------------------------------------------------------------------
MFA_REQUIRED_FOR_STAFF=True
MFA_ISSUER=FacultyNxtGen
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
# SECURE_SSL_REDIRECT=True
# SECURE_HSTS_SECONDS=31536000
# SECURE_HSTS_INCLUDE_SUBDOMAINS=True
# SECURE_HSTS_PRELOAD=True
# USE_X_FORWARDED_HOST=True
SESSION_COOKIE_AGE=28800

# ---------------------------------------------------------------------------
# Uploads and retention
# ---------------------------------------------------------------------------
MAX_DOCUMENT_SIZE=5242880
MAX_IMAGE_SIZE=2097152
# CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=3310
DOCUMENT_DOWNLOAD_LINK_TTL=600
CANDIDATE_DATA_RETENTION_DAYS=365
AUDIT_LOG_RETENTION_DAYS=730

# ---------------------------------------------------------------------------
# Observability
# ---------------------------------------------------------------------------
LOG_LEVEL=INFO
# SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0.1

# ---------------------------------------------------------------------------
# Brand and contact details
# ---------------------------------------------------------------------------
CONTACT_PHONE=+91 90000 00000
CONTACT_ADDRESS=FacultyNxtGen, Bengaluru, Karnataka, India
SOCIAL_LINKEDIN=
SOCIAL_INSTAGRAM=
SOCIAL_X=
DEMO_MODE=False
