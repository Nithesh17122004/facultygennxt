# Example Nginx site for FacultyNxtGen.
# Replace facultynxtgen.com with the real host and obtain certificates before
# enabling the HTTPS block (for example with `certbot --nginx`).

upstream facultynxtgen_app {
    server 127.0.0.1:8000;
    keepalive 16;
}

server {
    listen 80;
    listen [::]:80;
    server_name facultynxtgen.com www.facultynxtgen.com;

    location /.well-known/acme-challenge/ {
        root /var/www/html;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name facultynxtgen.com www.facultynxtgen.com;

    ssl_certificate /etc/letsencrypt/live/facultynxtgen.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/facultynxtgen.com/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;

    server_tokens off;
    client_max_body_size 12m;
    client_body_timeout 30s;

    access_log /var/log/nginx/facultynxtgen.access.log;
    error_log /var/log/nginx/facultynxtgen.error.log warn;

    # Public static assets.
    location /static/ {
        alias /srv/facultynxtgen/staticfiles/;
        access_log off;
        expires 30d;
        add_header Cache-Control "public, max-age=2592000, immutable";
        try_files $uri =404;
    }

    # Public brand/blog media only.
    location /media/private/ {
        return 404;
    }

    location /media/ {
        alias /srv/facultynxtgen/media/public/;
        access_log off;
        expires 7d;
        try_files $uri =404;
    }

    # Never serve dotfiles.
    location ~ /\.(?!well-known) {
        deny all;
    }

    location / {
        proxy_pass http://facultynxtgen_app;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        proxy_redirect off;
        proxy_connect_timeout 10s;
        proxy_read_timeout 65s;
        proxy_send_timeout 65s;
    }
}
