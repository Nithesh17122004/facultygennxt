[Unit]
Description=FacultyNxtGen Celery beat scheduler
After=network.target postgresql.service redis-server.service
Wants=postgresql.service redis-server.service

[Service]
Type=simple
User=facultynxtgen
Group=www-data
WorkingDirectory=/srv/facultynxtgen
EnvironmentFile=/srv/facultynxtgen/.env
ExecStart=/srv/facultynxtgen/.venv/bin/celery -A config beat --loglevel=INFO --scheduler django_celery_beat.schedulers:DatabaseScheduler
Restart=always
RestartSec=5
PrivateTmp=true
NoNewPrivileges=true
ProtectSystem=full
ProtectHome=true

[Install]
WantedBy=multi-user.target
